# Production env for https://plum-cod-233835.hostingersite.com
# Copy to .env on the server and fill in real values.

APP_NAME="Appalto Smart"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://plum-cod-233835.hostingersite.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# MySQL on Hostinger (use credentials from hPanel → Databases)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Allow SPA on same domain (no CORS issues when frontend is same origin)
SANCTUM_STATEFUL_DOMAINS=plum-cod-233835.hostingersite.com

# AI (optional – keep same as local if you use extraction)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
